# Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit your real .env file.
# Use a unique random value for each environment.
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
AUTHENTICATION_SIGNING_KEY=replace-with-at-least-32-random-utf8-bytes

# Optional direct host connection for local tools (API container uses the postgres service hostname).
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=samaneh;Username=samaneh_app;Password=replace-with-a-long-random-local-password
